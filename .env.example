# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改（所有值都有默认值；direct/browser 需要登录态，light 用浏览器登录态）
# ---------------------------------------------------------------------------

# DeepSeek 网页登录态。推荐用 `npm run auth -- <userToken>` 写入 data/auth.json，
# 而不是把 token 放在这里。
# 号池：多个 token 用空格/逗号分隔（推荐写进 data/auth.json：npm run auth -- t1 t2）
# DEEPSEEK_USER_TOKENS=
# DEEPSEEK_USER_TOKEN=
# 引擎：auto（默认：有协议凭据先走 protocol，否则 direct / browser）
#       | protocol（纯 HTTP：Node 直连 chat.deepseek.com，cookie+hif 从 profile 采集，Go 解 PoW）
#       | direct（直连 + Go 解 PoW，只有 token，不带 cookie/hif）
#       | light（在已登录浏览器页面里 fetch，请求由浏览器网络栈发出，不驱动 UI）
#       | hybrid（真实键鼠事件驱动页面 UI，抓页面原生补全流；默认不启用）
#       | browser（Playwright 驱动真实网页）
ENGINE=auto

# 协议通道（ENGINE=protocol / auto）
# 凭据文件：cookie / userToken / x-hif 缓存采集后落盘（data/ 已 gitignore，mode 0600）
# PROTOCOL_CREDENTIALS_FILE=data/protocol-credentials.json
# 401/403/invalid token/40003 时从 hybrid profile 刷新一次凭据再重试
# PROTOCOL_REFRESH_ON_AUTH_FAIL=true
# 刷新后仍失败，是否降级到 hybrid 全浏览器
# PROTOCOL_FALLBACK_HYBRID=true
# 采集时页面停留时间（给风控 SDK 写 hif 缓存的余量）
# PROTOCOL_HARVEST_WAIT_MS=2500
# Go PoW 求解器
POW_BIN=bin/ds-pow
# PoW 并行度：默认 = CPU 核数；压测时可设 1 对比单核性能
# POW_WORKERS=8
# 设为任意值可关掉 ARMv8.2 SHA3 汇编 Keccak，回退纯 Go（正常情况下不需要）
# POW_NO_NEON=1
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# 深度思考：always（默认，打开网页上的「深度思考」）| auto（按模型名）| never
# 请求体里传 "thinking": false 可以单次关闭
DEEPSEEK_THINKING=always
# 智能搜索：默认关闭
DEEPSEEK_SEARCH=false
# 是否主动把网页上的「深度思考 / 智能搜索」开关拨到请求要求的状态
DEEPSEEK_MANAGE_TOGGLES=true
DEFAULT_MODEL=deepseek-flash

# ---------------------- 浏览器特征（直连模式） ----------------------
# 设备画像：chrome-win（桌面 Chrome）| chrome-android（移动 Chrome）
# 选定后请长期固定，不要来回切换，否则请求中的 UA / 平台会在不同时间跳变
DEEPSEEK_DEVICE_PROFILE=chrome-win
# 冷启动序列：启动时先拉配置、校验设备、回执配置，让账号有「网页打开过」的痕迹
DEEPSEEK_COLD_START=true
# 行为时序：把 PoW 求解耗时补到接近真浏览器 JS 的水平，并在发送前加随机停顿
DEEPSEEK_HUMAN_TIMING=true

# ---------------------------- 服务 ----------------------------
HOST=127.0.0.1
PORT=8787
# 设置后，客户端必须带 Authorization: Bearer <API_KEY>
API_KEY=
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------------------------- 浏览器 ----------------------------
BROWSER_HEADLESS=true
# BROWSER_USER_AGENT=...
# CHROMIUM_EXECUTABLE=/path/to/chrome
# 无 root 环境下解包出来的依赖库目录
CHROMIUM_DEPS_DIR=~/.local/chromium-deps
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900
BROWSER_LOCALE=zh-CN

# ---------------------------- 运行 ----------------------------
# 同时跑几个浏览器页面（每个请求占一个页面，手机/小内存建议 1）
CONCURRENCY=1
QUEUE_LIMIT=64
REQUEST_TIMEOUT_MS=240000
FIRST_TOKEN_TIMEOUT_MS=90000
POLL_INTERVAL_MS=60
SETTLE_MS=800
# 两次发送的最小间隔与触发「发送过于频繁」后的退避
SEND_INTERVAL_MS=4000
# 直连引擎的发送间隔（网页接口没有浏览器那么严，可以更快）
DIRECT_SEND_INTERVAL_MS=0
# 同一账号任意两条上游请求的最小间隔（毫秒）。单账号始终串行，这是串行之外的节奏。
# 默认 8000：实测 2026-11-04 19:28 间隔中位数 2.2s、27 条/97s 时触发 429；
# 8s 约等于稳态 ≤7.5 条/分钟，是实测失败阈值的 1/2。不要设低于 4000。
ACCOUNT_MIN_GAP_MS=8000
# 工具长任务（本次请求带 tools）专用的单账号最小间隔（毫秒），默认 15000。
# 普通对话仍用 ACCOUNT_MIN_GAP_MS；带 tools 的轮次按本值排队（单账号 start-to-start）。
# 15s 把工具轮理论上限压到 4 条/分钟，与实测 429 阈值 11 条/分钟留约 2.75 倍余量。
ACCOUNT_TOOL_MIN_GAP_MS=15000
# 某个账号被 429 限流后的冷却时间，以及请求最多愿意等多久（超过就返回 429）
ACCOUNT_COOLDOWN_MS=60000
MAX_COOLDOWN_WAIT_MS=5000
# 上游「user is muted」的账号冷却（毫秒），默认 15 分钟。
# 实测 00:30 首次禁言后 00:45 仍禁言；冷却结束只允许 1 次探测，仍禁言就翻倍并停止。
MUTED_COOLDOWN_MS=900000
REASONING_HOLD_MS=900
RATE_LIMIT_BACKOFF_MS=4000
# 空闲多久关闭浏览器释放内存（0 = 不关闭）
IDLE_SHUTDOWN_MS=900000
# 启动时预热浏览器（省掉第一次请求的 2~3 秒）
WARMUP=true
# 浏览器模式：抓页面自己发出的补全接口原始流，用模型原始输出（含工具调用 token）当权威文本，
# DOM 只负责流式展示。关掉退回纯 DOM 提取（偶发丢工具调用的风险变高）。
BROWSER_CAPTURE=true
# DOM 提前判定结束时，最多再等原始流收尾多久（毫秒），用来补齐被截断的尾部 token
BROWSER_CAPTURE_WAIT_MS=20000
# 模型自己编造工具结果（RESULT）时，非流式请求带着更硬的约束重试一次
# 检测到模型自己写 RESULT / 伪造段落标题时，立即中止生成并先返回已拿到的正文和工具调用
# （模型编造结果后会继续长篇续写，不早停会让请求一直卡到超时）
# 网页输入框单次上限；超过就把较早的对话拆成 .txt 附件（ref_file_ids）注入
MAX_PROMPT_CHARS=100000
# 拆到附件的上下文最多多少字符
MAX_ATTACHMENT_CHARS=2000000
# 关掉则恢复旧行为：超长直接返回 413（browser 引擎不支持附件；direct / protocol / light 支持）
OVERFLOW_TO_ATTACHMENT=true
SAVE_ARTIFACTS=true

# ---------------------------- light 引擎 ----------------------------
# 登录态来源（优先级）：LIGHT_PROFILE_DIR > LIGHT_CDP_URL > 默认 http://127.0.0.1:9222
# 1) 复用一台已经登录 chat.deepseek.com 的浏览器（Chrome/Edge 加 --remote-debugging-port=9222）
# LIGHT_CDP_URL=http://127.0.0.1:9222
# 2) 用持久化用户目录启动 Chromium（该目录需登录过一次）
# LIGHT_PROFILE_DIR=data/light-profile
# 3) profile 模式下注入 Playwright storageState（cookies + localStorage，含 HttpOnly cookie）
#    在已登录浏览器里执行 context.storageState({ path: 'data/light-state.json' }) 导出
# LIGHT_STORAGE_STATE=data/light-state.json
# LIGHT_HEADLESS=true
# LIGHT_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# LIGHT_NAV_TIMEOUT_MS=60000
# 存活守护：CDP 断开 / 页面崩溃 / 上下文关闭时按指数退避自动重连（次数 + 总时限）
# LIGHT_RECONNECT_MAX=5
# LIGHT_RECONNECT_TOTAL_MS=30000

# ---------------------------- hybrid 引擎 ----------------------------
# 默认不启用：ENGINE=hybrid 才会加载。
# 做法：IME/键盘真实输入 + 贝塞尔鼠标点击，然后抓页面自己发出的 completion SSE。
# 默认使用独立持久化 profile（data/hybrid-profile），不碰 127.0.0.1:9222，也不碰日常 Edge。
# 首次登录：npm run auth:hybrid
# HYBRID_PROFILE_DIR=data/hybrid-profile
# 可选：显式复用某个已登录浏览器（不设就永远走独立 profile）
# HYBRID_CDP_URL=http://127.0.0.1:9222
# HYBRID_STORAGE_STATE=data/hybrid-state.json
# 有头更接近真实用户；无显示环境才设 true（会改变页面可观测特征，不建议）
# HYBRID_HEADLESS=false
# 默认系统 Edge（UA/navigator 与日常浏览器一致），失败回退 Playwright Chromium
# HYBRID_CHANNEL=msedge
# HYBRID_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# HYBRID_NAV_TIMEOUT_MS=60000
# 重连退避（页面崩溃/浏览器关闭）
# HYBRID_RECONNECT_MAX=5
# HYBRID_RECONNECT_TOTAL_MS=30000
# 空闲自动关闭浏览器（毫秒，默认 15 分钟 = 与 browser 引擎一致；0 = 不关闭）。
# 登录态留在 profile 目录，下个请求自动冷启动。
# HYBRID_IDLE_CLOSE_MS=900000
# 固定单页面：并发请求排队，超过上限立即 429（不无限堆积、不再开标签）
# HYBRID_QUEUE_LIMIT=8
# 流式模式：incremental（默认，CDP Network 真增量逐块推送）| batch（收完整体回放，仅对照用）
# HYBRID_STREAM_MODE=incremental
# 拟人化装饰：默认全关（没有证据表明能降低风控，且会显著拖慢输入）。
# 需要做对照实验时再打开：
# HYBRID_IME=true
# HYBRID_TYPING_RHYTHM=true
# HYBRID_MOUSE_CURVE=true
# HYBRID_TYPO_RATE=0.015
# 逐字基础停顿（毫秒）。默认 6ms 快速档，仍逐字产生真实 keydown/keyup/input/beforeinput
# HYBRID_TYPING_DELAY_MS=6
# 前 N 个字符走真实键盘事件，长 prompt 的其余部分用 insertText 批量注入
# HYBRID_TYPE_SAMPLE_CHARS=80
# 每轮先点「开启新对话」，保持「一条请求 = 一次全新对话」
# HYBRID_NEW_CHAT=true
